{
  "name": "chatgpt-grafana-alerts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/main.ts",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "typecheck": "tsc --noEmit",
