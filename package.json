    "check": "npm run typecheck && npm test",
    "package:plugin": "node scripts/package-plugin.ts"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.14",
    "standardwebhooks": "^1.1.1",
