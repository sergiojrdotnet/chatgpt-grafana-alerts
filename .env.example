HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/alerts.sqlite
SOURCE_ID=grafana

# Generate separate values with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GRAFANA_WEBHOOK_SECRET=
STORAGE_KEY=

# Local development only. Leave empty when configuring OAuth.
DEV_MCP_TOKEN=
AUTH_MODE=oauth

# Cloudflare Managed OAuth origin mode uses these instead of OAUTH_*.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=

# OAuth production mode: all three URLs must use HTTPS.
# PUBLIC_URL is the canonical origin, without /mcp or a trailing slash.
PUBLIC_URL=
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_ALLOWED_SUBJECTS=
